# Copia este archivo como .env y llena los valores reales.
# El archivo .env NO se sube al repositorio.

# --- Servidor ---
PORT=3000
NODE_ENV=development
TZ=America/Mexico_City

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=cambia_esta_contrasena
PGDATABASE=mchat

# --- Sesión ---
# Cadena larga y aleatoria para firmar los JWT
JWT_SECRETO=cambia_esto_por_una_cadena_larga_y_aleatoria
# Duración de la sesión en horas
SESION_HORAS=8
# Rondas de bcrypt (mínimo 10)
BCRYPT_RONDAS=12
# false porque el proyecto corre en localhost sin HTTPS
COOKIE_SECURE=false

# --- Aviso de privacidad ---
VERSION_AVISO=1.0

# --- Administrador principal (lo usa "npm run crear-admin") ---
ADMIN_CORREO=admin@ejemplo.com
ADMIN_CONTRASENA=cambia_esta_contrasena
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDOS=Principal
